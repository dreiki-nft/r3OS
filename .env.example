# Public Monad testnet defaults used by the current hackathon build.
# Every VITE_ variable ships in the browser bundle: never put secrets or private RPC credentials here.
VITE_CHAIN_ID=10143

# Optional legacy primary RPC. When set, it is placed first in VITE_RPC_URLS.
VITE_RPC_URL=
# General read pool. Transactions from connected wallets use VITE_WALLET_RPC_URL; Live Mode has its own action lane.
VITE_RPC_URLS=https://testnet-rpc.monad.xyz,https://rpc.ankr.com/monad_testnet,https://rpc-testnet.monadinfra.com
VITE_LOGS_RANGE=100
VITE_RPC_RPS=12
VITE_RPC_BATCH_SIZE=10

# Optional Phase 9B read accelerator. This is the PUBLIC Cloudflare Worker route, never the FastLane secret.
# Active only on chain 143. If unavailable, r3OS falls back to direct public Monad RPC automatically.
VITE_FASTLANE_ACCELERATOR_URL=
VITE_FASTLANE_ACCELERATOR_TIMEOUT_MS=650
VITE_DEPLOY_BLOCK=67823235
VITE_WS_URL=wss://testnet-rpc.monad.xyz
VITE_WALLET_RPC_URL=https://testnet-rpc.monad.xyz
VITE_EXPLORER_URL=https://testnet.monadvision.com

VITE_PAINT_ADDRESS=0x032D5e1591DA2919A4aa5D24Ee9278bFE5F1CdA1
# Legacy fallback for VITE_PAINT_ADDRESS only.
VITE_CONTRACT_ADDRESS=

# Optional active registry overrides. Blank = discover the newest non-retired entry from R3OSPaint.
VITE_AUCTION_ADDRESS=
VITE_QUESTS_ADDRESS=
VITE_MULTICALL3_ADDRESS=

VITE_NFT_API_URL=
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
VITE_REVEAL_ALL=true

# Public identifier shown by DXDIAG.EXE. Never put a secret here.
VITE_BUILD_ID=snapshot-28-testnet
# Optional public production origin for link-preview images. Vercel supplies its production domain when blank.
VITE_SITE_URL=

# Phase 9B FastLane rule:
# FastLane confirmed the Enterprise URL must not be exposed in frontend code. Never put it in VITE_RPC_URLS.
# Only the optional PUBLIC Cloudflare Worker route above may be browser-visible. The FastLane URL itself stays
# in a Cloudflare Worker secret (or a local shell variable for read-only capability probes).
