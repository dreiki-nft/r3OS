# Every VITE_ variable ships in the browser bundle.
VITE_CHAIN_ID=10143
# Optional legacy primary RPC. When set, it is placed first in VITE_RPC_URLS.
VITE_RPC_URL=
# Comma-separated public app RPCs, in fallback order.
VITE_RPC_URLS=
# Maximum eth_getLogs block span requested from an RPC. Public-safe default: 100.
VITE_LOGS_RANGE=100
# Per-endpoint JSON-RPC request budget, requests per second.
VITE_RPC_RPS=12
# JSON-RPC batch size. Set 0 to disable batching.
VITE_RPC_BATCH_SIZE=10
# Deployment block. Every historical log read is clamped to this block or later.
VITE_DEPLOY_BLOCK=0
# Optional websocket endpoint for live blocks/events. Falls back to polling when blank.
VITE_WS_URL=
# The only RPC URL ever exposed to wallet_addEthereumChain / wallet chain metadata.
VITE_WALLET_RPC_URL=
VITE_EXPLORER_URL=
VITE_PAINT_ADDRESS=
# Legacy fallback for VITE_PAINT_ADDRESS only.
VITE_CONTRACT_ADDRESS=
# Optional Lab overrides. Blank = resolve newest non-retired entry from the core registry.
VITE_FLIPBOOK_ADDRESS=
VITE_WEEDS_ADDRESS=
VITE_FORKS_ADDRESS=
VITE_BRUSHES_ADDRESS=
VITE_AUCTION_ADDRESS=
VITE_QUESTS_ADDRESS=
VITE_MULTICALL3_ADDRESS=
VITE_NFT_API_URL=
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
