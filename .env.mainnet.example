# Monad MAINNET settings for running r3OS locally against the live contracts (public RPCs only):
#   cp .env.mainnet.example .env.local && npm run dev
# Every VITE_ variable ships in the browser bundle: never put secrets or private RPC credentials here.
VITE_CHAIN_ID=143

VITE_RPC_URL=
VITE_RPC_URLS=https://rpc.monad.xyz,https://rpc2.monad.xyz
VITE_LOGS_RANGE=100
VITE_RPC_RPS=12
VITE_RPC_BATCH_SIZE=10

# The optional read accelerator is not needed locally; r3OS reads the public RPCs directly.
VITE_FASTLANE_ACCELERATOR_URL=
VITE_FASTLANE_ACCELERATOR_TIMEOUT_MS=650
# Earliest block r3OS scans for events: a safe lower bound, shortly before the October 6, 2026 deployment.
VITE_DEPLOY_BLOCK=111000000
VITE_WS_URL=wss://rpc.monad.xyz
VITE_WALLET_RPC_URL=https://rpc.monad.xyz
VITE_EXPLORER_URL=https://monadvision.com

VITE_PAINT_ADDRESS=0x5102de3817ae16b3afaeb9d180130669a70787b3
VITE_CONTRACT_ADDRESS=

# Blank = discover the newest non-retired entry from R3OSPaint (same as production).
VITE_AUCTION_ADDRESS=
VITE_QUESTS_ADDRESS=
VITE_MULTICALL3_ADDRESS=

VITE_NFT_API_URL=
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
VITE_REVEAL_ALL=true

VITE_BUILD_ID=local-mainnet
VITE_SITE_URL=
