# Foundry deployment values. Copy to contracts/.env locally; never commit contracts/.env.
# No raw private key belongs here. Broadcast with --ledger or --account <keystore>.
DEPLOYER_ADDRESS=
R3TARDS_ADDRESS=0x200723A706de0013316E5cd8EBa2b3f53DD90c29
SEASON_START=
TOKEN_ZERO_RECIPIENT=0x40Ea55E0b8f02f8eBc9D91e082e202ed988647fA
ROYALTY_RECEIVER=0x40Ea55E0b8f02f8eBc9D91e082e202ed988647fA
# Mainnet: set explicitly to the intended Safe. Defaults to DEPLOYER_ADDRESS only when blank.
FINAL_OWNER=

# Canonical chain-143 launch budgets. Keep aligned with Launch Doctor + PRE_MAINNET_CHECKLIST.
BASE_PIXELS_PER_HOUR=512
PIXELS_PER_ACTIVE_DAY=32
MAX_PIXELS_PER_HOUR=2048
MIN_PIXELS_FOR_ACTIVE_DAY=16
HOLDER_PIXELS_PER_DAY=512
# Set only after the identical deployment has been validated on testnet.
CONFIRM_MAINNET=false

# Optional public base URI used by Lab registry display metadata.
LAB_BASE_URI=
