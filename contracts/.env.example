# Foundry deployment values. Copy to contracts/.env locally; never commit contracts/.env.
# No raw private key belongs here. Broadcast with --ledger or --account <keystore>.
DEPLOYER_ADDRESS=
R3TARDS_ADDRESS=0x200723A706de0013316E5cd8EBa2b3f53DD90c29
SEASON_START=
TOKEN_ZERO_RECIPIENT=0x40Ea55E0b8f02f8eBc9D91e082e202ed988647fA
ROYALTY_RECEIVER=0x40Ea55E0b8f02f8eBc9D91e082e202ed988647fA
# Mainnet: set explicitly to the intended final owner / Safe. Defaults to DEPLOYER_ADDRESS only when blank.
FINAL_OWNER=

# Canonical chain-143 launch budgets. Keep aligned with Launch Doctor + deployment manifest.
BASE_PIXELS_PER_HOUR=512
PIXELS_PER_ACTIVE_DAY=32
MAX_PIXELS_PER_HOUR=2048
MIN_PIXELS_FOR_ACTIVE_DAY=16
HOLDER_PIXELS_PER_DAY=512

# Optional public base URI used by Lab registry display metadata.
LAB_BASE_URI=

# Public addresses produced by earlier deployment stages. Populate from
# `npm run mainnet:collect-addresses`; do not guess or hand-transcribe if avoidable.
PAINT_ADDRESS=
LABS_ADDRESS=
PASS_ADDRESS=
QUESTS_ADDRESS=
CARD_MEMORY_ADDRESS=

# Official Monad Cards mainnet collection used by CARD.DRV.
MONAD_CARD_ADDRESS=0x0000CA12D5c07085022eBC74867157449919Fd67

# System Event mainnet feed/config. Choose MON_FEED_MAX_AGE only after the read-only
# mainnet preflight confirms the live feed and its current update cadence/freshness.
MON_USD_FEED=0xBcD78f76005B7515837af6b50c7C52BCf73822fb
MON_PRICE_TRIGGER_MILLI_USD=333
MON_FEED_MAX_AGE=

# Test/local Router Lab only. Chain 143 rejects mock venues regardless of this value.
DEPLOY_MOCK_VENUES=false

# MAINNET APPROVAL FLAGS
# Leave these false in files. The scripts inspect Foundry execution context: dry-runs do not need them.
# Set them only in the executing shell immediately after explicit approval for the exact action.
CONFIRM_MAINNET=false
CONFIRM_ACCEPT_OWNERSHIP=false
CONFIRM_FREEZE_RENDERERS=false
