{
  "name": "r3os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "repo:doctor": "node scripts/repo-doctor.mjs",
    "check:web": "npm run repo:doctor && npm run test:web && npm run build",
    "contracts:build": "forge build --root contracts && node scripts/check-contract-sizes.mjs",
    "contracts:test": "forge test --root contracts",
    "outline:export": "node scripts/export-outline.mjs",
    "abi:export": "node scripts/export-abi.mjs",
    "generated:check": "npm run outline:export && npm run abi:export && git diff --exit-code -- src/lib/generated/outline.ts src/lib/generated/abi.ts",
    "check": "npm run repo:doctor && npm run contracts:build && npm run contracts:test && npm run test:web && npm run generated:check && npm run build",
    "test:web": "vitest run --maxWorkers=8",
    "launch:doctor": "node scripts/launch-doctor.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.1",
    "solady": "0.1.26",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "5.0.2"
  }
}
